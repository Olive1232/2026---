; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="2026聚光灯"
run/main_scene="uid://cdtobi53ukrc7"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

; 顺序很重要：被别的脚本用全局标识符引用的 autoload 必须**排在前面**，
; 否则会随机报 "Identifier not found: <名字>"（初始化顺序竞争）。
; CoinPool 被 Hole.gd / Coin.gd 引用，所以放最前。
CoinPool="*res://Scripts/Economy/CoinPool.gd"
_mcp_game_helper="*res://addons/godot_ai/runtime/game_helper.gd"
EventBus="*res://Scripts/Autoload/EventBus.gd"
Wallet="*res://Scripts/Autoload/Wallet.gd"

[display]

window/stretch/mode="viewport"
window/stretch/aspect="expand"

[editor_plugins]

enabled=PackedStringArray("res://addons/godot_ai/plugin.cfg", "res://addons/sprite_forge/plugin.cfg")

